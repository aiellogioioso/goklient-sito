---
import Logo from './Logo.astro';
import { config, testoWindows } from '../config';
const s = config.societa;
const anno = 2026;
---
<footer class="site-footer">
  <div class="container">
    <div class="site-footer__top">
      <div class="site-footer__brand">
        <Logo size={44} motto />
        <p class="small">Per telefono e tablet Android. {testoWindows}</p>
      </div>
      <nav aria-label="Pagine del sito" class="site-footer__cols">
        <div>
          <h2 class="site-footer__h">goKlient</h2>
          <ul>
            <li><a href="/come-funziona">Come funziona</a></li>
            <li><a href="/mestieri">Per il tuo mestiere</a></li>
            <li><a href="/prezzi">Prezzi</a></li>
            <li><a href="/scarica">Scarica</a></li>
          </ul>
        </div>
        <div>
          <h2 class="site-footer__h">Aiuto</h2>
          <ul>
            <li><a href="/domande-frequenti">Domande frequenti</a></li>
            <li><a href="/assistenza">Assistenza</a></li>
            {config.manualePubblicato && <li><a href={config.manualeUrl}>Manuale d'uso (PDF)</a></li>}
            <li><a href={`mailto:${config.emailAssistenza}`}>{config.emailAssistenza}</a></li>
          </ul>
        </div>
        <div>
          <h2 class="site-footer__h">I tuoi dati</h2>
          <ul>
            <li><a href="/privacy">Informativa sulla privacy</a></li>
            <li><a href="/condizioni">Condizioni d'uso</a></li>
            <li><a href="/elimina-account">Eliminare l'account e i dati</a></li>
          </ul>
        </div>
      </nav>
    </div>
    <div class="site-footer__legal small">
      {s ? (
        <p>{s.ragioneSociale} · {s.sede} · {s.codiceFiscale === s.partitaIva ? `C.F. e P.IVA ${s.partitaIva}` : `P.IVA ${s.partitaIva} · C.F. ${s.codiceFiscale}`} · REA {s.rea} · Capitale sociale {s.capitale} · PEC <a href={`mailto:${s.pec}`}>{s.pec}</a></p>
      ) : (
        <p class="placeholder">[goKlient s.r.l. in costituzione: ragione sociale, sede, partita IVA, codice fiscale, REA, capitale, PEC da inserire appena disponibili]</p>
      )}
      <p>© {anno} goKlient · {config.motto}</p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--surface-2); border-top: 1px solid var(--line); padding-block: 56px 32px; margin-top: 24px; }
  .site-footer__top { display: grid; gap: 40px; }
  .site-footer__brand .small { margin-top: 16px; max-width: 320px; }
  .site-footer__cols { display: grid; gap: 28px; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  .site-footer__h { font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--ink-3); margin-bottom: 12px; }
  .site-footer ul { list-style: none; padding: 0; margin: 0; }
  .site-footer li { margin-bottom: 4px; }
  .site-footer li a { display: inline-block; padding: 8px 0; color: var(--ink); text-decoration: none; font-weight: 600; }
  .site-footer li a:hover { color: var(--brand-strong); text-decoration: underline; }
  .site-footer__legal { border-top: 1px solid var(--line); margin-top: 40px; padding-top: 24px; }
  @media (min-width: 900px) { .site-footer__top { grid-template-columns: 1fr 2fr; } }
</style>
