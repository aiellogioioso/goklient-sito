---
// Layout comune: <head> con titolo e descrizione per Google (sezione 10 del brief), intestazione,
// contenuto, blocco finale "Hai una domanda?" e pie' di pagina.
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FinalBlock from '../components/FinalBlock.astro';
import { config } from '../config';
// Stesso file dell'@font-face in global.css: Vite gli da' lo stesso nome con impronta, quindi si scarica una volta sola.
import manropeUrl from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';

interface Props {
  title: string;          // tag <title>, entro ~60 caratteri (qui la parola CRM e' ammessa)
  description: string;    // meta description, entro ~155 caratteri
  finalBlock?: boolean;   // blocco "Hai una domanda?" in fondo (default: si')
  noindex?: boolean;
}
const { title, description, finalBlock = true, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site);
const ogImage = new URL('/og.png', Astro.site);
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preload" href={manropeUrl} as="font" type="font/woff2" crossorigin />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0f9e97" />
    {(noindex || config.anteprima) && <meta name="robots" content="noindex, nofollow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="it_IT" />
    <meta property="og:site_name" content="goKlient" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#contenuto">Vai al contenuto</a>
    <Header />
    <main id="contenuto">
      <slot />
    </main>
    {finalBlock && <FinalBlock />}
    <Footer />
    <script is:inline>
      // Testi "Completo" (details.more): sul telefono restano chiusi, dal computer si aprono da soli.
      (function () {
        if (window.matchMedia && window.matchMedia('(min-width: 900px)').matches) {
          document.querySelectorAll('details.more').forEach(function (d) { d.open = true; });
        }
      })();
    </script>
  </body>
</html>
